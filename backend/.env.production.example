# =============================================================================
# Lucky Care Plus - production environment template
# =============================================================================
#
# Copy this file to backend/.env before the first `docker compose --profile app
# up -d --build`, then fill in every value marked CHANGE_ME. Never commit
# backend/.env (it is gitignored) and never bake it into the image.
#
#   cp backend/.env.production.example backend/.env
#   docker compose --profile app build app
#   docker compose --profile app run --rm --no-deps app php artisan key:generate --show
#   # paste the printed key into APP_KEY below, then bring the stack up.
#
# The compose `app` profile overrides DB_HOST/DB_PORT and REDIS_HOST/REDIS_PORT
# for the container network; the values below are also correct for a host
# process that reaches the published developer ports (5433/6380).
#
# Every variable read by backend/config/*.php appears in this file. Optional
# driver-specific knobs are commented out; uncomment only when the matching
# driver is selected. backend/docs/DEPLOYMENT.md section 11 explains them all.
#
# Production safety rules encoded here:
#   * AI_ENABLED=false until G4/D1 are signed off.
#   * OTP_DEMO_MODE=false (production refuses it anyway).
#   * RETENTION_DRY_RUN=true until the retention numbers are approved.
#   * DOCUMENTS_SCAN_REQUIRED=true is the default since 2026-10-25: a document is
#     only stored after a clean verdict. Start the scanner
#     (`docker compose --profile app --profile scan up -d`) or uploads fail closed
#     (503 scan_unavailable). Set it to false only if this deployment stores no
#     documents at all.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Lucky Care Plus"
APP_ENV=production
APP_DEBUG=false
# Public URL of the API as seen by clients. Must include the external scheme.
APP_URL=https://CHANGE_ME.example
# Generate with: php artisan key:generate --show (or the docker one-off above).
APP_KEY=
# Comma-separated previous keys, used while rotating APP_KEY. Leave empty.
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Trusted proxies. The application trusts X-Forwarded-* headers only from the
# IPs/CIDRs listed here. It must name every hop between the client and php-fpm:
# in the reference compose stack that is the Caddy and nginx containers, so a
# private compose subnet (for example 172.16.0.0/12) is the practical value.
# `*` trusts the calling address and is only safe when nothing but the proxy can
# reach the application (it lets any direct client forge its own IP and scheme).
# See backend/docs/DEPLOYMENT.md section 13.
TRUSTED_PROXIES=

# Redirect plain-HTTP requests to HTTPS and generate https:// URLs. Enable it
# once TLS terminates in front of the stack. The internal /up and /ready probes
# are exempt so the container healthcheck over plain HTTP still succeeds.
FORCE_HTTPS=false

# Readiness probe (`GET /ready`). Unset = auto: Redis is checked when the cache,
# queue or session driver is redis. Production should force it on, because Redis
# carries the queue and the rate limiter even when the cache is on the database.
# Set to false for a deployment with no Redis at all (for example a CI runner).
READINESS_CHECK_REDIS=

# Laravel hashing default. The repository currently has no config/hashing.php,
# so this is the framework default rather than a wired knob.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Database (PostgreSQL is the only supported production database)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lucky_care_plus
# Runtime role: NOSUPERUSER, NOBYPASSRLS. Never connect as `postgres`; a
# superuser bypasses every RLS policy (ADR-013).
DB_USERNAME=luckycare_app
DB_PASSWORD=CHANGE_ME
# prefer / require / verify-full. Use verify-full with a CA in production.
DB_SSLMODE=prefer
DB_FOREIGN_KEYS=true
DB_CHARSET=utf8

# Optional full DSN; when set it wins over the discrete values above.
# DB_URL=
# PostgreSQL unix socket (only when not using TCP).
# DB_SOCKET=
# MySQL/SQL Server-only knobs, read by config/database.php for those drivers:
# DB_COLLATION=utf8mb4_unicode_ci
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false
# MYSQL_ATTR_SSL_CA=

# Cache/queue tables when the database driver is used (the defaults are the
# migrated `cache` and `jobs` tables).
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# Must be greater than the queue worker's --timeout=120 (docker-compose.yml).
DB_QUEUE_RETRY_AFTER=150

# -----------------------------------------------------------------------------
# Redis (cache / session / queue when those drivers are set to redis)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_USERNAME=
# REDIS_URL=
# REDIS_PREFIX=lucky-care-plus-database-
# REDIS_PERSISTENT=false
# REDIS_CLUSTER=redis
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# Must be greater than the queue worker's --timeout=120 (docker-compose.yml).
REDIS_QUEUE_RETRY_AFTER=150

# -----------------------------------------------------------------------------
# Session / cache / queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=

CACHE_STORE=redis
# CACHE_PREFIX=
# CACHE_STORAGE_DISK=
# CACHE_STORAGE_PATH=framework/cache/data
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=

QUEUE_CONNECTION=redis
# QUEUE_FAILED_DRIVER=database-uuids
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Filesystem (local volume vs S3 / MinIO)
# -----------------------------------------------------------------------------
# local keeps documents and exports on the appstorage named volume. For a
# multi-host or off-host deployment switch DOCUMENTS_DISK/EXPORTS_DISK to s3 and
# set the AWS_* block (MinIO uses AWS_ENDPOINT + path-style).
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
EXPORTS_DISK=local

# EXPORTS_RETENTION_DAYS=7
# EXPORTS_RATE_LIMIT_HOURS=24
# EXPORTS_LINK_TTL_MINUTES=15

# AWS / S3 / MinIO (required when a disk above is `s3`).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# `log` is a staging value. A production deployment must point this at a real
# relay that has been checked for PHI leakage policy (N-02).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME.smtp.example
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.example"
MAIL_FROM_NAME="Lucky Care Plus"
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
# MAIL_LOG_CHANNEL=
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# OTP / authentication
# -----------------------------------------------------------------------------
# MUST stay false. The application refuses demo mode when APP_ENV=production;
# a true value here makes the OTP endpoint fail loudly instead of leaking codes.
OTP_DEMO_MODE=false

# AUTH_GUARD=web
# AUTH_PASSWORD_BROKER=users
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# Sanctum token prefix and stateful domains (the mobile app uses bearer tokens).
# SANCTUM_TOKEN_PREFIX=
# SANCTUM_STATEFUL_DOMAINS=localhost:8080

# -----------------------------------------------------------------------------
# Documents (upload limit + malware scanning)
# -----------------------------------------------------------------------------
# 10 MiB, enforced against the actual bytes by DocumentService.
DOCUMENTS_MAX_BYTES=10485760

# The scanner is fail-closed. Leave both `scan_required=false` and `scanner`
# empty until a clamd unix socket is reachable from the app container. To turn
# scanning on (D4 owner decision):
#   DOCUMENTS_SCANNER=clamav
#   DOCUMENTS_CLAMAV_SOCKET=/path/shared/with/clamd
#   DOCUMENTS_SCAN_REQUIRED=true
DOCUMENTS_SCAN_REQUIRED=true
DOCUMENTS_SCANNER=clamav
DOCUMENTS_CLAMAV_SOCKET=tcp://clamav:3310
DOCUMENTS_CLAMAV_TIMEOUT=10

# -----------------------------------------------------------------------------
# Retention (ADR-016)
# -----------------------------------------------------------------------------
# Forced on for at least the first 30 days of a deployment. Turning it off is
# an owner decision (D3) after the privacy notice and retention numbers land.
RETENTION_DRY_RUN=true

# -----------------------------------------------------------------------------
# AI gateway (ADR-018)
# -----------------------------------------------------------------------------
# OFF until G4 is signed off and the provider/DPA decision D1 is made.
#   * AI_ENABLED=false makes every AI endpoint return 503 `ai_disabled`.
#   * AI_PROVIDER=null uses the deterministic in-process provider.
#   * The HTTP adapter only activates when AI_PROVIDER, AI_BASE_URL, AI_API_KEY
#     and a model are all set.
# See .ai/08-AI-GATEWAY.md, backend/docs/LOCAL-AI-PATHUMMA.md and G4.
AI_ENABLED=false
AI_PROVIDER=null
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Aliases read by config/ai.php: AI_MODEL_1 is the default text model,
# AI_MODEL_2 the vision model.
# AI_MODEL_1=
# AI_MODEL_2=
# AI_MODEL_VISION=
# AI_MODEL_SUMMARY=
# AI_MODEL_KNOWLEDGE=
# Comma-separated allow-list of models that may receive an image.
# AI_VISION_MODELS=
# AI_TIMEOUT=20
# AI_MAX_RETRIES=1
# AI_PER_USER_DAY=20
# AI_PER_USER_MINUTE=5
# AI_MAX_TOKENS=1500
# AI_TEMPERATURE=0.2
# AI_LOCALE=th

# -----------------------------------------------------------------------------
# Health knowledge base (SQLite + FTS5)
# -----------------------------------------------------------------------------
# The image ships database/knowledge; these defaults resolve inside the image.
# KNOWLEDGE_SQLITE_PATH=/var/www/html/database/knowledge/health_kb.sqlite
# KNOWLEDGE_SOURCES_PATH=/var/www/html/database/knowledge/sources
# KNOWLEDGE_BENCHMARK_PATH=/var/www/html/database/knowledge/benchmark/queries.json
# KNOWLEDGE_TOP_K=5
# KNOWLEDGE_MAX_QUESTION_CHARS=500
# KNOWLEDGE_CHUNK_CHARS=900
# KNOWLEDGE_CHUNK_OVERLAP=150
# KNOWLEDGE_FETCH_TIMEOUT=30
# KNOWLEDGE_FETCH_DELAY_MS=1000

# -----------------------------------------------------------------------------
# Logging and observability
# -----------------------------------------------------------------------------
# stderr is the right channel in containers: `docker compose logs` and the
# host's log collector own rotation. N-02 still forbids health data in logs.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
# LOG_DAILY_DAYS=14
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=LOG_USER

# Optional external log/alert sinks already wired by config/logging.php.
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="Lucky Care Plus"
# LOG_SLACK_EMOJI=:boom:
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# The application has no metrics/tracing endpoint yet; see
# backend/docs/DEPLOYMENT.md section 10 item 2. Do not invent PULSE_/TELESCOPE_
# keys.
